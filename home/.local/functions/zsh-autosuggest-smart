# Custom zsh-autosuggestions strategy: when the cursor is mid-word, only
# suggest a completion if that word fragment appears as a whole word in history.
# Falls through (no suggestion) when at a space, letting the normal
# history/completion strategies handle it.
_zsh_autosuggest_strategy_smart() {
    local buffer="$1"
    local cursor_pos="$CURSOR"

    # Only act when cursor is touching a word character (mid-word)
    local char_at_cursor="${buffer[$cursor_pos]}"
    [[ "$char_at_cursor" =~ [[:alnum:]_.-] ]] || return

    # Extract the word fragment up to the cursor
    local before_cursor="${buffer[1,$cursor_pos]}"
    local current_word="${before_cursor##* }"
    [[ -z "$current_word" ]] && return

    # Strip leading non-alphanumeric characters (e.g. quotes: "exp -> exp)
    local search_word="${current_word#"${current_word%%[[:alnum:]]*}"}"
    [[ -z "$search_word" ]] && return

    # Search in-memory history for a word that starts with the fragment
    local matched_word
    matched_word=$(fc -ln 1 2>/dev/null \
        | grep -oP "(?<![^\s])${search_word}[^\s]*" \
        | sort -u | head -1)
    [[ -z "$matched_word" ]] && return

    # Only suggest if the match extends the fragment
    [[ "$matched_word" == "$search_word" ]] && return

    # Suggestion: replace only the search portion, preserving any leading punctuation
    local prefix="${current_word%$search_word}"
    suggestion="${before_cursor%$current_word}${prefix}${matched_word}"
}
