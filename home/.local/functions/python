python() {
    local _PYTHON=/run/current-system/sw/bin/python

    case "$1" in
    venv)
        "$_PYTHON" -m venv .venv --copies
        ;;
    *)
        if [[ -n "$VIRTUAL_ENV" && -x "$VIRTUAL_ENV/bin/python" ]]; then
            "$VIRTUAL_ENV/bin/python" "$@"
        else
            "$_PYTHON" "$@"
        fi
        ;;
    esac
}
