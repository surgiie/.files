json() {
    case "$1" in
    pipe)
        jq -Rr --indent 2 '
            . as $line |
            ($line | index("{")) as $i |
            if $i == null then $line
            elif $i > 0 then ($line[:$i] | rtrimstr(" ")), (try ($line[$i:] | fromjson) catch empty)
            else (try ($line | fromjson) catch empty)
            end
        '
        ;;
    *)
        echo "Usage: json <subcommand>"
        echo
        echo "Subcommands:"
        echo "  pipe  - pipe json strings through jq, passing non-json lines through unchanged"
        return 1
        ;;
    esac
}
