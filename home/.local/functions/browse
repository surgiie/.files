browse() {
    local BROWSER="google-chrome-stable"
    local BROWSER_CLASS="google-chrome"
    local BOOKMARKS_FILE="$HOME/.config/google-chrome/Default/Bookmarks"
    local URL

    if [[ "$1" == "-b" || "$1" == "--bookmarks" ]]; then
        URL=$(jq -r '
            .roots | .. | objects | select(has("type") and .type == "url") |
            (if .name == "" then .url else .name end) + "\t" + .url
        ' "$BOOKMARKS_FILE" | fzf --with-nth=1 --delimiter='\t' --tty | cut -f2)
        [[ -z "$URL" ]] && return 0
    elif [[ "$1" == "-s" || "$1" == "--search" ]]; then
        shift
        local SEARCH_QUERY="${*// /+}"
        URL="https://www.google.com/search?q=$SEARCH_QUERY"
    else
        URL="$1"
    fi

    "$BROWSER" "$URL" &>/dev/null &

    for _ in $(seq 1 50); do
        hyprctl clients -j | jq -e ".[] | select(.class == \"$BROWSER_CLASS\")" &>/dev/null && break
        sleep 0.1
    done

    hyprctl dispatch "hl.dsp.focus({window='class:$BROWSER_CLASS'})" &>/dev/null

    local fullscreen
    fullscreen=$(hyprctl activewindow -j | jq -r '.fullscreen')
    if [[ "$fullscreen" != "2" ]]; then
        hyprctl dispatch 'hl.dsp.window.fullscreen_state({internal=2, client=0, action="set"})' &>/dev/null
    fi
}
